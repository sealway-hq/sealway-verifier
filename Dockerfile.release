# The image GoReleaser wraps around an already built binary. It is not a build
# environment: the binary is compiled on the runner and copied in.
#
# distroless/static carries a certificate bundle and nothing else — no shell, no
# package manager, no libc. The bundle is the part that matters: the verifier
# reads blockchain endpoints and European Trusted Lists over HTTPS, and an image
# without trusted roots would fail every one of those and report them as
# skipped, which reads like a network problem rather than a missing file.
#
# Pinned by digest rather than by tag, so an image built today and an image
# built next month contain the same thing.
FROM gcr.io/distroless/static@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

COPY sealway-verifier /usr/local/bin/sealway-verifier

# The verifier never writes anywhere it is not told to, and needs no privilege.
USER 65532:65532

ENTRYPOINT ["/usr/local/bin/sealway-verifier"]
